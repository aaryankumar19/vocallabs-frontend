# FastAPI Backend Configuration
# Change port if FastAPI runs on a different port (e.g. 8000)
VITE_FASTAPI_BACKEND_URL="http://192.168.137.116:8000"

# LiveKit WebRTC Cloud URL
VITE_LIVEKIT_URL="wss://vocallabsai-qun1rvmf.livekit.cloud"

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Application type: Web application)
# 3. Add Authorized redirect URIs:
#    - http://localhost:8080/auth/callback
#    - http://localhost:5173/auth/callback
#    - http://192.168.137.116:8000/auth/google/callback
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
VITE_GOOGLE_CALLBACK_URL="http://localhost:8080/auth/callback"
